# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_DB=claimwise
POSTGRES_USER=claimwise
POSTGRES_PASSWORD=change-me
APP_ENV=development
# Host port for the API (http://127.0.0.1:${API_PORT}).
API_PORT=8000
# Local development only. Override these outside a local dev environment.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-admin-password
