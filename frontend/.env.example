# Shared API base URL.
NEXT_PUBLIC_API_BASE_URL=

# Auth.js session encryption secret: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Keycloak realm imported from ../../infra/keycloak/claimwise-realm.json.
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/claimwise
AUTH_KEYCLOAK_ID=claimwise-web
# Public OIDC client uses Authorization Code + PKCE (S256); do not set a client secret.
AUTH_KEYCLOAK_SECRET=
NEXT_PUBLIC_KEYCLOAK_CONFIGURED=true
